        <mxCell id="_WwMTctBhN9jkaiaMy75-11" value="Key Performance Indicators" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="_WwMTctBhN9jkaiaMy75-6">
          <mxGeometry x="35" y="40" width="160" height="30" as="geometry" />
        </mxCell>
        <mxCell id="_WwMTctBhN9jkaiaMy75-17" value="&lt;p style=&quot;language:es-MX;margin-top:0pt;margin-bottom:0pt;margin-left:0in;&lt;br/&gt;text-align:left;direction:ltr;unicode-bidi:embed;mso-line-break-override:none;&lt;br/&gt;word-break:normal;punctuation-wrap:hanging&quot;&gt;&lt;span style=&quot;font-size: 10pt; color: black;&quot;&gt;To ensure the success and growth of the team, we will focus on global company metrics.&lt;/span&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="_WwMTctBhN9jkaiaMy75-6">
