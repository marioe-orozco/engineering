        <mxCell id="_WwMTctBhN9jkaiaMy75-1" value="Cloud Engineering Strategy" style="text;whiteSpace=wrap;html=1;fontSize=24;align=center;" vertex="1" parent="1">
          <mxGeometry x="160" y="-45" width="530" height="40" as="geometry" />
        </mxCell>
        <mxCell id="_WwMTctBhN9jkaiaMy75-2" value="&lt;p style=&quot;line-height: 150%; margin-top: 0pt; margin-bottom: 0pt; margin-left: 0in; direction: ltr; unicode-bidi: embed; word-break: normal;&quot;&gt;&lt;span style=&quot;font-size: 10pt; font-family: Arial;&quot;&gt;This strategy describes how a Cloud Engineering team can operate efficiently at Google Cloud, focusing on metrics, goals, SLAs, roles, and skills to generate $1 million in annual sales per team member.&lt;/span&gt;&lt;/p&gt;" style="text;whiteSpace=wrap;html=1;fontColor=light-dark(#000000,#FFFFFF);align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="5" width="760" height="100" as="geometry" />
        </mxCell>
        <mxCell id="_WwMTctBhN9jkaiaMy75-25" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;flowAnimation=1;fillColor=#e51400;strokeColor=#B20000;" edge="1" parent="1" source="_WwMTctBhN9jkaiaMy75-5" target="_WwMTctBhN9jkaiaMy75-4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
